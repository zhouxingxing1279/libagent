@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Only dependencies reachable through libagent's PUBLIC interface are found here.
# spdlog is PRIVATE (compiled in) and GoogleTest is test-only, so neither is
# listed. nlohmann/json is vendored and shipped inside the include tree.
find_dependency(Boost CONFIG REQUIRED COMPONENTS headers)

if(@LIBAGENT_WITH_SSL@)
    find_dependency(OpenSSL REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/libagentTargets.cmake")

check_required_components(libagent)
